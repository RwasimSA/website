{
  // النسخة التجريبية demo.rwasim.sa — نفس الموقع لكن بقاعدة محتوى منفصلة
  // (rwasim-content-demo) حتى تُجرَّب التعديلات وتُعتمد قبل النشر الرسمي.
  // النشر: دفعة إلى فرع demo في GitHub (deploy-demo.yml)
  "name": "website-demo",
  "main": "worker/index.js",
  "compatibility_date": "2026-01-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "demo.rwasim.sa", "custom_domain": true }
  ],
  "vars": {
    // تمنع فهرسة النسخة التجريبية في محركات البحث (X-Robots-Tag)
    "DEMO": "1"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/files/*", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rwasim-content-demo",
      "database_id": "0b156ac7-0ccc-4be6-8f19-67d15fb9c9d4"
    }
  ],
  "r2_buckets": [
    {
      // نفس مخزن ملفات الإنتاج — فالملفات المرفوعة تجريبياً تبقى صالحة بعد النشر
      "binding": "FILES",
      "bucket_name": "rwasim-files"
    }
  ]
}
