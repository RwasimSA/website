{
  // موقع ثابت + Worker خفيف لبوابة دخول لوحة التحكم (GitHub OAuth).
  // كل المسارات تُخدم من أصول public/ عدا /api/oauth/* التي يعالجها الـWorker.
  "name": "website",
  "main": "worker/index.js",
  "compatibility_date": "2026-01-01",
  // روابط معاينة لكل نسخة مرفوعة (لا تمس النشرة الفعلية على rwasim.sa)
  "preview_urls": true,
  "assets": {
    // يُنشر محتوى public/ فقط (ناتج البناء). جذر المستودع خارج النطاق عمدًا.
    "directory": "./public",
    "binding": "ASSETS",
    // مسارات الصفحات (/programs، /gov-data…) تُخدم من index.html — توجيه داخل التطبيق
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      // نفس قاعدة محتوى اللوحة — للقراءة عبر GET /api/content
      "binding": "DB",
      "database_name": "rwasim-content",
      "database_id": "f5532985-e471-4af8-8916-23163743462d"
    }
  ],
  "r2_buckets": [
    {
      // ملفات لوحة ديوان — تُقدَّم عبر GET /files/<key>
      "binding": "FILES",
      "bucket_name": "rwasim-files"
    }
  ]
}
