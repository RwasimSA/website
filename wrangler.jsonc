{
  // الموقع الرسمي rwasim.sa — أصول public/ + Worker يقدّم المحتوى الحي
  // من D1 (/api/content) والملفات من R2 (/files/*).
  // النشر: npx wrangler deploy
  "name": "website",
  "main": "worker/index.js",
  "compatibility_date": "2026-01-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "rwasim.sa", "custom_domain": true }
  ],
  "assets": {
    // يُنشر محتوى public/ فقط (ناتج البناء). جذر المستودع خارج النطاق عمدًا.
    "directory": "./public",
    "binding": "ASSETS",
    // مسارات الصفحات (/programs، /gov-data…) تُخدم من index.html — توجيه داخل التطبيق
    "not_found_handling": "single-page-application",
    // الملفات وAPI تمر على الـWorker دائماً حتى عند فتحها مباشرة في المتصفح —
    // بدونها يعترض توجيه SPA تنزيل الملفات ويعرض الرئيسية بدلها
    "run_worker_first": ["/files/*", "/api/*"]
  },
  "d1_databases": [
    {
      // نفس قاعدة محتوى اللوحة — للقراءة عبر GET /api/content
      "binding": "DB",
      "database_name": "rwasim-content",
      "database_id": "f5532985-e471-4af8-8916-23163743462d"
    }
  ],
  // إشعار بريدي إلى info@ عند كل طلب شراكة أو تطوع (Cloudflare Email Service).
  // يعمل بعد تفعيل الإرسال لنطاق rwasim.sa وتوثيق info@rwasim.sa كعنوان مستلم؛
  // وقبل ذلك يفشل الإرسال بصمت ويبقى الطلب محفوظاً في اللوحة.
  "send_email": [
    { "name": "NOTIFY" }
  ],
  "vars": {
    "NOTIFY_FROM": "no-reply@rwasim.sa",
    "NOTIFY_TO": "info@rwasim.sa"
  },
  "r2_buckets": [
    {
      // ملفات لوحة ديوان — تُقدَّم عبر GET /files/<key>
      "binding": "FILES",
      "bucket_name": "rwasim-files"
    }
  ]
}
