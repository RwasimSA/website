{
  // نسخة المعاينة العامة للموقع الجديد على beta.rwasim.sa —
  // تطبيق مستقل تماماً عن website فلا يمس rwasim.sa الأساسي.
  // النشر: npx wrangler deploy -c wrangler.beta.jsonc
  "name": "website-beta",
  "main": "worker/index.js",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "beta.rwasim.sa", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      // نفس قاعدة محتوى اللوحة — تعديلات ديوان تظهر هنا مباشرة
      "binding": "DB",
      "database_name": "rwasim-content",
      "database_id": "f5532985-e471-4af8-8916-23163743462d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "rwasim-files"
    }
  ]
}
