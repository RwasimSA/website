{
  // ⚠️ هذا التطبيق أصبح «الإنتاج»: ربطت المنظمة rwasim.sa به مباشرة
  // (2026-09-09) بدل خط النشر القديم عبر تطبيق website.
  // النشر: npx wrangler deploy -c wrangler.beta.jsonc
  "name": "website-beta",
  "main": "worker/index.js",
  "compatibility_date": "2026-01-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "rwasim.sa", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // مسارات الصفحات (/programs، /gov-data…) تُخدم من index.html — توجيه داخل التطبيق
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      // نفس قاعدة محتوى اللوحة — تعديلات ديوان تظهر هنا مباشرة
      "binding": "DB",
      "database_name": "rwasim-content",
      "database_id": "f5532985-e471-4af8-8916-23163743462d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "rwasim-files"
    }
  ]
}
